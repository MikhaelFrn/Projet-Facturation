# Copy this file to .env.local and fill in real values once the Supabase
# project is provisioned. Until then, leave .env.local absent/empty and the
# app runs on mock data (see db/client.ts: isDatabaseConfigured).

# Postgres connection string used by Drizzle (db/client.ts). In Supabase:
# Project Settings > Database > Connection string > "Transaction" pooler
# (port 6543) for serverless/Next.js API routes.
DATABASE_URL=

# Only needed once Supabase Auth/Storage/Realtime are used directly from the
# client via @supabase/supabase-js — not required for the Drizzle data layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Needed for privileged operations
# (e.g. voiding a paid invoice) once those routes are built.
SUPABASE_SERVICE_ROLE_KEY=